{
  "$schema": "https://deno.land/x/deno/cli/schemas/config-file.v1.json",
  "tasks": {
    "check": "deno check scripts/**/*.ts",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "md:lint": "npx markdownlint-cli2 '**/*.md' '#node_modules'",
    "md:fmt": "npx prettier --write '**/*.md'",
    "md:fmt:check": "npx prettier --check '**/*.md'",
    "md:links": "lychee --offline '**/*.md'",
    "html:fmt": "npx prettier --write 'templates/**/*.html'",
    "css:fmt": "npx prettier --write 'styles/**/*.css'",
    "convert": "deno run --allow-read --allow-write scripts/md-to-tsv.ts",
    "all:check": "deno task fmt:check && deno task lint && deno task check && deno task md:fmt:check && deno task md:lint"
  },
  "imports": {
    "@std/fs": "jsr:@std/fs@^1.0.0",
    "@std/path": "jsr:@std/path@^1.0.0",
    "@std/yaml": "jsr:@std/yaml@^1.0.0",
    "@std/csv": "jsr:@std/csv@^1.0.0",
    "markdown-it": "npm:markdown-it@^14.0.0"
  },
  "fmt": {
    "lineWidth": 100,
    "indentWidth": 2,
    "singleQuote": false,
    "proseWrap": "preserve"
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  },
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true
  }
}
