{
  "$schema": "https://raw.githubusercontent.com/DavidAnson/markdownlint/main/schema/markdownlint-config-schema.json",
  "default": true,
  // Allow long lines (common in vocabulary definitions)
  "MD013": false,
  // Allow multiple top-level headings (each word file may have multiple entries)
  "MD025": false,
  // Allow trailing punctuation in headings (e.g., "Bonjour!")
  "MD026": {
    "punctuation": ".,;:。，；："
  },
  // Allow inline HTML (useful for Anki compatibility)
  "MD033": false,
  // Allow bare URLs (convenient for references)
  "MD034": false
}
